# ==========================================
# GemClip - Configuration des Clés API
# ==========================================

# --- 1. Groq API (Analyse IA & Extraction de Shorts) ---
# Obtenez votre clé sur : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- 2. PayPal (Abonnements Plus & Paiements) ---
# Obtenez vos identifiants sur : https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_PLAN_ID=
PAYPAL_CURRENCY=EUR

# --- 3. Firebase Authentication & Cloud Firestore ---
# Configuration de votre projet Firebase (Console > Paramètres du projet)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=